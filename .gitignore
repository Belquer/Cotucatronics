# artefatos de build do firmware
build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst

# macOS
.DS_Store

# nunca versionar os zips de entrega
*.zip
__pycache__/

# lixo de bisseccao do ERC — ficheiros de teste, nao fonte nem produto
docs/operacao/esquematicos/revB/erc/
# recortes de inspeccao visual — material de trabalho, nao entrega
docs/operacao/esquematicos/revB/render/*.png

# --- projeto KiCad (kicad/) ---
# O projeto ENTRA no git a partir de 04/09; fica de fora o que nao e desenho.
#
# ⚠️ COMENTARIO EM LINHA PROPRIA. O git NAO aceita comentario no fim da linha
# de um padrao: o texto todo passa a fazer parte do padrao e a regra deixa de
# casar. Escrito primeiro com `.history/  # historico local` — e o `.history/`
# continuou a aparecer como nao-ignorado, com o seu .git dentro.
#
# historico local do editor — traz um .git DENTRO dele
.history/
# preferencias locais da maquina, nao do projeto
*.kicad_prl
# ficheiro de bloqueio: existe enquanto o KiCad esta aberto
*.lck
*-backups/
fp-info-cache

# saidas regeraveis do gerador da caixa (o .svg/.dxf de corte ficam: sao o
# registo do que foi para a fabrica; a previa e so para olhar)
caixa/*_previa.svg
__pycache__/

# pacotes de fabrico: sao gerados por para_fabrica.py, e um pacote guardado
# no repositorio envelhece em silencio enquanto a placa muda
fabrica/

# ficheiros de trabalho do faz_placa: ferrolho e copias intermedias
kicad/.faz_placa.lock
*.kicad_pcb.limpo
*.kicad_pcb.melhor
