	(text "9  Anel do TRS ao AGND junto do sleeve: blindagem de graca no cabo."
		(exclude_from_sim no)
		(at 25.4 381 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "350ba0b9-3a14-46eb-9070-2697bf126081")
	)
	(text "   separar as fontes PIORA (8-16 kHz: +9,6 -> +17,3 -> +24,3 dB). Trilho unico + filtro local, nao separacao."
		(exclude_from_sim no)
		(at 25.4 365.76 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "4c0a48ed-0d75-45d0-ad88-fdd27ce16705")
	)
	(text "   esta e sobe o sinal 20 dB acima do ruido captado. Ganho cedo, atenuacao tarde."
		(exclude_from_sim no)
		(at 25.4 321.31 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "4f03d771-81c4-46ec-9a93-a7577e5de8f8")
	)
	(text "2  A ENCENACAO e o ponto, nao o ganho: pre-amp +20 dB com pre_level_ab a descer 20 dB deixa o ganho de LACO onde"
		(exclude_from_sim no)
		(at 25.4 316.23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "57beeebf-f41f-4ef9-bd0d-aa6fdcb09198")
	)
	(text "6  C1 22p e C2 1n cortam RF antes do ADC - inclui a comutacao a 400 kHz do classe D, medida acoplada em 01/09."
		(exclude_from_sim no)
		(at 25.4 355.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "65426dc5-5a3a-48d5-8d63-a12e27e571e9")
	)
	(text "CANAL B"
		(exclude_from_sim no)
		(at 25.4 148.59 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "6e046505-3b77-42cc-b71c-8e4186b794de")
	)
	(text "3  R1 4M7 com piezo de ~20 nF corta em 1,7 Hz. Entrada de 10k cortaria em 800 Hz - foi por isso que o pre de"
		(exclude_from_sim no)
		(at 25.4 326.39 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "7e514630-b879-4643-b7f5-ed273f209739")
	)
	(text "   nem se copia entre unidades. Cada corpo da serie tem montagem de piezo diferente."
		(exclude_from_sim no)
		(at 25.4 311.15 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "891d8b2d-ea4a-4aa2-a0a2-63a58217c5d0")
	)
	(text "   de saida (C4). Nunca X7R onde passa sinal."
		(exclude_from_sim no)
		(at 25.4 350.52 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "8b3c90ac-a9d6-4879-94b1-6c6a1b5ccac0")
	)
	(text "8  Layout: pre-amp encostado aos jacks de entrada, dentro da ILHA DE AGND, pista de entrada curta."
		(exclude_from_sim no)
		(at 25.4 370.84 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "9727ec1b-3ea3-425f-99c2-9a28dc806670")
	)
	(text "7  Alimentacao pelo MESMO trilho de 15V do amp, filtrada por R7/C6/C7. Medido em 01/09 em tres topologias:"
		(exclude_from_sim no)
		(at 25.4 360.68 0)
		(effects
