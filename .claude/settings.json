{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./docs/operacao/hook_stop.sh",
            "timeout": 45,
            "statusMessage": "/audit no fecho..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./docs/operacao/hook_commit.sh",
            "timeout": 15,
            "statusMessage": "verificadores baratos..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"AGORA: $(TZ=America/New_York date '+%A %Y-%m-%d %H:%M %Z')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
