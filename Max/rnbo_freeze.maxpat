                                    "patching_rect": [ 1050.0, 115.0, 240.0, 78.0 ],
                                    "text": "When the Freeze toggle is engaged, a new recording of 200 ms starts in the buffer named FreezeA. When a new freeze command is received, the new recording occurs in the buffer named FreezeB."
                                }
